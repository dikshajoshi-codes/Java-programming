class Book
{
	String title , Author;
	long price;
	int pages;
	
	Book (String title, String Author)
	{
	    
	    this.title = title;
	    this.Author = Author;
	    price = 10;
	    pages = 5;
	    
	 }
	 
	 Book (String title, String Author,long price)
	 {
	  
	    this.title = title;
	    this.Author = Author;
	    this.price = price;
	    pages = 5 ;
	  
	  }
	  
	  Book (String title, String Author, long price, int pages)
	  { 
	 
	     this.title = title;
	     this.Author = Author;
	     this.price = price;
	     this.pages = pages;
	  
	   }
	   
	   void displayDetails()
	   { 
